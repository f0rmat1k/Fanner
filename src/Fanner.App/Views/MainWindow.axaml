<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Fanner.App.ViewModels"
        xmlns:controls="using:Fanner.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1120" d:DesignHeight="740"
        x:Class="Fanner.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/fanner.ico"
        Title="Fanner"
        Width="1120" Height="780"
        MinWidth="880" MinHeight="600"
        Background="{DynamicResource PageBackground}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,16,20,12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Classes="h1" Text="Fanner" />
                        <Border Classes="badge" IsVisible="{Binding IsSimulated}">
                            <TextBlock Classes="caption" Text="SIMULATED" />
                        </Border>
                    </StackPanel>
                    <TextBlock Classes="caption" Text="{Binding DetectedHardware}"
                               IsVisible="{Binding IsRunning}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                            VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center"
                                IsVisible="{Binding IsRunning}">
                        <TextBlock Classes="caption" Text="Profile" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding ProfileNames}"
                                  SelectedItem="{Binding SelectedProfileName}"
                                  MinWidth="130"
                                  AutomationProperties.Name="Active profile" />
                    </StackPanel>

                    <Button Content="&#x2699;" FontSize="15" Padding="9,4"
                            IsVisible="{Binding IsRunning}"
                            Command="{Binding OpenSettingsCommand}"
                            AutomationProperties.Name="Settings"
                            ToolTip.Tip="Profiles and settings" />

                    <!-- Only meaningful once we hold a fan, and it is the escape
                         hatch, so it sits where it can always be found. -->
                    <Button Content="Restore all to BIOS"
                            Command="{Binding RestoreAllToFirmwareCommand}"
                            IsVisible="{Binding IsDrivingAnyFan}" />

                    <TextBlock Classes="caption" VerticalAlignment="Center"
                               Text="{Binding LastUpdated, StringFormat='updated {0}'}"
                               IsVisible="{Binding IsRunning}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Banners stack: the watchdog firing also pauses curves, so both can be
             on screen at once and must not sit on top of each other. -->
        <StackPanel Grid.Row="1" Spacing="8">

            <!-- The watchdog fired and already handed the fans back. -->
            <Border Classes="card" Margin="20,0,20,0"
                    Background="{DynamicResource WarningBackground}"
                    BorderBrush="{DynamicResource WarningBorder}"
                    IsVisible="{Binding HasSafetyAlert}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Classes="h2" Text="Temperature limit reached"
                                   Foreground="{DynamicResource AccentWarn}" />
                        <TextBlock Text="{Binding SafetyAlert}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimary}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Dismiss" VerticalAlignment="Center"
                            Command="{Binding DismissSafetyAlertCommand}" />
                </Grid>
            </Border>

            <!-- Curves exist but are standing down. Shown because a curve that
                 silently does nothing is indistinguishable from a broken one. -->
            <Border Classes="card" Margin="20,0,20,0"
                    Background="{DynamicResource BadgeBackground}"
                    IsVisible="{Binding AreCurvesSuspended}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Classes="h2" Text="Curves are paused" />
                        <TextBlock Classes="caption" Text="{Binding CurvesSuspendedReason}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Resume curves" VerticalAlignment="Center"
                            Command="{Binding ResumeCurvesCommand}" />
                </Grid>
            </Border>

        </StackPanel>

        <!-- Starting -->
        <TextBlock Grid.Row="2" Classes="h2"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Text="{Binding StatusHeadline}"
                   IsVisible="{Binding IsStarting}" />

        <!-- Failure, with the fix attached -->
        <Border Grid.Row="2" Classes="card" Margin="20"
                Background="{DynamicResource WarningBackground}"
                BorderBrush="{DynamicResource WarningBorder}"
                VerticalAlignment="Top"
                IsVisible="{Binding IsFailed}">
            <StackPanel Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
                <TextBlock Classes="h1" Text="{Binding StatusHeadline}" />
                <TextBlock Text="{Binding StatusDetail}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimary}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Restart as administrator"
                            Command="{Binding RelaunchElevatedCommand}"
                            IsVisible="{Binding CanFixByElevating}" />
                    <Button Content="Get PawnIO"
                            Command="{Binding OpenDriverPageCommand}"
                            IsVisible="{Binding NeedsDriverInstall}" />
                    <Button Content="Use simulated hardware"
                            Command="{Binding UseSimulationCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Dashboard -->
        <Grid Grid.Row="2" ColumnDefinitions="*,340" Margin="20,4,20,20"
              IsVisible="{Binding IsRunning}">

            <Grid Grid.Column="0" RowDefinitions="*,Auto" Margin="0,0,16,0">

                <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding FanGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FanGroupViewModel">
                                <StackPanel Margin="0,0,0,8">

                                    <!-- Grouped by hardware: the graphics card drives
                                         its own fans through the vendor API, while the
                                         case and CPU headers all hang off the board's
                                         Super I/O chip. -->
                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                Margin="2,0,0,8">
                                        <TextBlock Classes="h2" Text="{Binding Title}" />
                                        <TextBlock Classes="caption" VerticalAlignment="Center"
                                                   Text="{Binding HardwareName}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <ItemsControl ItemsSource="{Binding Fans}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:FanViewModel">
                                                <Border Classes="card"
                                                        Classes.empty="{Binding IsEmptyHeader}"
                                                        Classes.stopped="{Binding IsStoppedByUs}"
                                                        Width="226" Height="192" Margin="0,0,10,10">
                                                    <Grid RowDefinitions="Auto,Auto,*,Auto">
                
                                                        <StackPanel Grid.Row="0" Spacing="1">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Grid.Column="0" Classes="h2"
                                                                           Text="{Binding Name}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <Border Grid.Column="1" Classes="badge"
                                                                        Classes.warn="{Binding IsSoftwareControlled}">
                                                                    <TextBlock Classes="caption" Text="{Binding ModeDisplay}" />
                                                                </Border>
                                                            </Grid>
                                                        </StackPanel>
                
                                                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Classes="metric" Text="{Binding RpmDisplay}" />
                                                                <Border Classes="badge warn" VerticalAlignment="Center"
                                                                        IsVisible="{Binding IsStoppedByUs}">
                                                                    <TextBlock Classes="caption" Text="STOPPED" />
                                                                </Border>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom"
                                                                        HorizontalAlignment="Right">
                                                                <TextBlock Classes="caption" Text="duty"
                                                                           HorizontalAlignment="Right" />
                                                                <StackPanel Orientation="Horizontal" Spacing="4"
                                                                            HorizontalAlignment="Right">
                                                                    <TextBlock Classes="h2" Text="{Binding DutyDisplay}" />
                                                                    <!-- The chip slews to a new duty over ~10 s, so
                                                                         show where it is heading or the reading looks
                                                                         like the write was ignored. -->
                                                                    <TextBlock Classes="h2" Text="{Binding TargetDisplay}"
                                                                               Foreground="{DynamicResource AccentWarn}"
                                                                               IsVisible="{Binding IsSlewing}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Grid>
                
                                                        <!-- RPM autoscales; duty is pinned to 0-100 so a
                                                             steady 60% reads as steady, not as noise. -->
                                                        <Grid Grid.Row="2" Margin="0,8,0,0">
                                                            <controls:Sparkline Values="{Binding DutyHistory}"
                                                                                Stroke="{DynamicResource AccentDuty}"
                                                                                StrokeThickness="1"
                                                                                Minimum="0" Maximum="100" />
                                                            <controls:Sparkline Values="{Binding RpmHistory}"
                                                                                Stroke="{DynamicResource AccentRpm}" />
                                                        </Grid>
                
                                                        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0">
                                                            <Slider Grid.Column="0"
                                                                    Value="{Binding TargetDuty, Mode=TwoWay}"
                                                                    Minimum="{Binding MinDuty}"
                                                                    Maximum="{Binding MaxDuty}"
                                                                    IsEnabled="{Binding IsSliderEnabled}"
                                                                    AutomationProperties.Name="{Binding Name}"
                                                                    VerticalAlignment="Center"
                                                                    Margin="0,0,6,0" />
                                                            <Button Grid.Column="1" Classes="revert"
                                                                    Content="&#x223F;"
                                                                    VerticalAlignment="Center"
                                                                    IsEnabled="{Binding CanControl}"
                                                                    Command="{Binding OpenCurveCommand}"
                                                                    AutomationProperties.Name="{Binding Name, StringFormat='Edit curve for {0}'}"
                                                                    ToolTip.Tip="Drive this fan from a temperature curve"
                                                                    Margin="0,0,4,0" />
                                                            <Button Grid.Column="2" Classes="revert"
                                                                    Content="&#x21ba;"
                                                                    VerticalAlignment="Center"
                                                                    IsEnabled="{Binding IsSoftwareControlled}"
                                                                    Command="{Binding ReleaseToFirmwareCommand}"
                                                                    AutomationProperties.Name="{Binding Name, StringFormat='Return {0} to BIOS'}"
                                                                    ToolTip.Tip="Give this fan back to the motherboard" />
                                                        </Grid>
                
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Shown only while we hold a fan, so the protection in force is
                     visible at the moment it becomes relevant. -->
                <TextBlock Grid.Row="1" Classes="caption" Margin="2,6,0,0"
                           IsVisible="{Binding IsDrivingAnyFan}"
                           Text="{Binding WatchdogSummary, StringFormat='Safety: fans return to BIOS above {0}'}" />

            </Grid>

            <!-- Curve editor. Takes over the side panel rather than opening a dialog:
                 the fan cards stay visible, so the fan being tuned can be watched
                 reacting to the curve as it is drawn. -->
            <Border Grid.Column="1" Classes="card" IsVisible="{Binding IsEditingCurve}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <!-- Right margin keeps the scrollbar off the controls; it
                         overlays the content rather than reserving a track. -->
                    <StackPanel Spacing="10" Margin="0,0,12,0" DataContext="{Binding CurveEditor}">

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="1">
                                <TextBlock Classes="h2" Text="{Binding FanName}" />
                                <TextBlock Classes="caption" Text="temperature curve" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Close" VerticalAlignment="Top"
                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CloseCurveEditorCommand}" />
                        </Grid>

                        <StackPanel Spacing="4">
                            <TextBlock Classes="caption" Text="Source" />
                            <ComboBox ItemsSource="{Binding Sensors}"
                                      SelectedItem="{Binding SelectedSensor}"
                                      HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Curve source sensor" />
                        </StackPanel>

                        <controls:CurveEditor x:Name="CurveCanvas"
                                              Height="200"
                                              Points="{Binding Points}"
                                              MarkerTemperature="{Binding MarkerTemperature}"
                                              Stroke="{DynamicResource AccentRpm}"
                                              MarkerBrush="{DynamicResource AccentWarn}"
                                              GridBrush="{DynamicResource CardBorder}"
                                              LabelBrush="{DynamicResource TextSecondary}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="caption"
                                       VerticalAlignment="Center"
                                       Text="Drag a point to reshape" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <Button Classes="revert" Content="+"
                                        Command="{Binding AddPointCommand}"
                                        ToolTip.Tip="Add a point" />
                                <Button Classes="revert" Content="&#x2212;"
                                        Command="{Binding RemovePointCommand}"
                                        ToolTip.Tip="Remove a point" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="Silent" Command="{Binding UseSilentCommand}" />
                            <Button Content="Balanced" Command="{Binding UseBalancedCommand}" />
                            <Button Content="Perf" Command="{Binding UsePerformanceCommand}" />
                        </StackPanel>

                        <Border Background="{DynamicResource BadgeBackground}" CornerRadius="6" Padding="10,8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Classes="caption" Text="at the current reading" />
                                <TextBlock Grid.Column="1" Classes="h2" Text="{Binding PredictedDuty}" />
                            </Grid>
                        </Border>

                        <StackPanel Spacing="2">
                            <TextBlock Classes="caption"
                                       Text="{Binding ResponseSeconds, StringFormat='Response — {0:0} s'}" />
                            <Slider Minimum="0" Maximum="30" Value="{Binding ResponseSeconds}"
                                    AutomationProperties.Name="Response seconds" />
                            <TextBlock Classes="caption" TextWrapping="Wrap"
                                       Text="Smooths the source, so a one-second spike does not surge the fans." />
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <TextBlock Classes="caption"
                                       Text="{Binding HysteresisPercent, StringFormat='Deadband — {0:0} %'}" />
                            <Slider Minimum="0" Maximum="10" Value="{Binding HysteresisPercent}"
                                    AutomationProperties.Name="Deadband percent" />
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <TextBlock Classes="caption"
                                       Text="{Binding KickstartDuty, StringFormat='Kickstart — {0:0} %'}" />
                            <Slider Minimum="0" Maximum="100" Value="{Binding KickstartDuty}"
                                    AutomationProperties.Name="Kickstart duty" />
                            <TextBlock Classes="caption" TextWrapping="Wrap"
                                       Text="Brief burst to restart a stopped fan, which will not spin up from rest at a low duty. 0 disables." />
                        </StackPanel>

                        <Button Content="Stop curve, return to BIOS"
                                HorizontalAlignment="Stretch"
                                Command="{Binding StopCurveCommand}" />

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Settings share the side panel with the curve editor, for the same
                 reason: a popup that dismisses on every activation change is no
                 place for controls people need to read before they touch. -->
            <Border Grid.Column="1" Classes="card" IsVisible="{Binding IsShowingSettings}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="14" Margin="0,0,12,0">

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="h2" Text="Profiles and settings" />
                            <Button Grid.Column="1" Content="Close" VerticalAlignment="Top"
                                    Command="{Binding CloseSettingsCommand}"
                                    AutomationProperties.Name="Close settings" />
                        </Grid>

                        <StackPanel Spacing="6">
                            <TextBlock Classes="caption" Text="PROFILES" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" PlaceholderText="New profile name"
                                         Text="{Binding NewProfileName}"
                                         Margin="0,0,6,0"
                                         AutomationProperties.Name="New profile name" />
                                <Button Grid.Column="1" Content="Add"
                                        Command="{Binding AddProfileCommand}"
                                        AutomationProperties.Name="Add profile" />
                            </Grid>
                            <TextBlock Classes="caption" TextWrapping="Wrap"
                                       Text="A new profile starts as a copy of what is running now." />
                            <Button Content="Delete current profile"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding DeleteProfileCommand}"
                                    AutomationProperties.Name="Delete profile" />
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource CardBorder}" />

                        <StackPanel Spacing="10">
                            <TextBlock Classes="caption" Text="SETTINGS" />

                            <CheckBox Content="Show empty headers"
                                      IsChecked="{Binding ShowEmptyHeaders}"
                                      AutomationProperties.Name="Show empty headers" />

                            <StackPanel Spacing="2">
                                <CheckBox Content="Closing the window keeps Fanner running"
                                          IsChecked="{Binding CloseToTray, Mode=OneWay}"
                                          Click="OnCloseToTrayClicked"
                                          AutomationProperties.Name="Close to tray" />
                                <TextBlock Classes="caption" TextWrapping="Wrap" Margin="28,0,0,0"
                                           Text="Quit from the tray icon to stop it and hand every fan back to the motherboard." />
                            </StackPanel>

                            <StackPanel Spacing="2">
                                <CheckBox Content="Start with Windows"
                                          IsChecked="{Binding RunAtStartup, Mode=OneWay}"
                                          Click="OnStartWithWindowsClicked"
                                          AutomationProperties.Name="Start with Windows" />
                                <TextBlock Classes="caption" TextWrapping="Wrap" Margin="28,0,0,0"
                                           Text="Registers a scheduled task that starts Fanner elevated at logon, with no UAC prompt. The Run registry key cannot do this." />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AccentWarn}"
                                   Text="{Binding SettingsError}"
                                   IsVisible="{Binding SettingsError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Classes="card" Padding="0"
                    IsVisible="{Binding IsShowingTemperatures}">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Classes="h2" Text="Temperatures" Margin="14,12,14,8" />
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding Temperatures}" Margin="14,0,14,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SensorViewModel">
                                    <Grid ColumnDefinitions="*,44,Auto" Margin="0,0,0,10">
                                        <StackPanel Grid.Column="0" Spacing="1" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="caption" Text="{Binding HardwareName}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <controls:Sparkline Grid.Column="1" Height="24"
                                                            Values="{Binding History}"
                                                            Stroke="{DynamicResource AccentTemp}"
                                                            StrokeThickness="1"
                                                            VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Display}"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

        </Grid>

    </Grid>

</Window>
